		lineageTag: 74f2cd52-b3a7-5284-9c2b-084adee7056f
		summarizeBy: none
		sourceColumn: store_id
		isHidden

		annotation SummarizationSetBy = Automatic

	column category_id
		dataType: string
		lineageTag: 5bbbaf17-4635-5ce4-922b-052f378ee9f7
		summarizeBy: none
		sourceColumn: category_id
		isHidden

		annotation SummarizationSetBy = Automatic

	column units
		dataType: int64
		formatString: #,0
		lineageTag: 2ee871e7-e4f1-5e2b-a967-9a0a0a3c1841
		summarizeBy: sum
		sourceColumn: units

		annotation SummarizationSetBy = Automatic

	column gross_sales
		dataType: double
		formatString: #,0
		lineageTag: 7b33e9d0-edfd-5581-b516-58d49e056755
		summarizeBy: sum
		sourceColumn: gross_sales

		annotation SummarizationSetBy = Automatic

	column discount
		dataType: double
		formatString: #,0
		lineageTag: 8cbc1290-faba-54a4-89de-2e5b3e1ee491
		summarizeBy: sum
		sourceColumn: discount

		annotation SummarizationSetBy = Automatic

	column returns
		dataType: double
		formatString: #,0
		lineageTag: 43ed9444-5249-504f-95e0-b7ce2fc5b86b
		summarizeBy: sum
		sourceColumn: returns

		annotation SummarizationSetBy = Automatic

	column net_sales
		dataType: double
		formatString: #,0
		lineageTag: fb65d703-7a4c-5d18-8598-58f063ab25c0
		summarizeBy: sum
		sourceColumn: net_sales

		annotation SummarizationSetBy = Automatic

	column cost_of_sales
		dataType: double
		formatString: #,0
		lineageTag: 7415fa89-98a0-5a19-8169-cccef92a32c5
		summarizeBy: sum
		sourceColumn: cost_of_sales

		annotation SummarizationSetBy = Automatic

	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_sales.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"store_id", type text}, {"category_id", type text}, {"units", Int64.Type}, {"gross_sales", type number}, {"discount", type number}, {"returns", type number}, {"net_sales", type number}, {"cost_of_sales", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
